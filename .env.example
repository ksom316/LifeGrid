# Copy this file to .env.local for local development (vercel dev reads it
# automatically). Never commit a file containing real values.

# Neon Postgres connection string. In the Neon console: Project > Connection
# Details > copy the "pooled connection" string (recommended for serverless
# functions, since it goes through Neon's connection pooler rather than
# opening a direct Postgres connection per invocation).
DATABASE_URL=postgres://user:password@ep-example-12345.us-east-2.aws.neon.tech/neondb?sslmode=require

# Vercel sets this automatically in deployed environments. Only set it
# locally if you want to exercise the production cookie behavior (adds the
# `Secure` flag, which requires HTTPS — not needed for local `vercel dev`
# over plain HTTP).
# NODE_ENV=production
